<view class="container">
  <!-- 顶部背景（含自定义导航栏，渐变贯穿） -->
  <view class="header-bg">
    <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
      <view class="header-content" style="height: {{navBarHeight}}px;">
        <view class="title-section">
          <text class="main-title">📚 礼金书架</text>
          <text class="sub-title">{{locked ? '请登录后查看' : '共 ' + books.length + ' 本账谱'}}</text>
        </view>
        <view class="user-avatar" bindtap="goToMine">
          <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-placeholder">👤</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 书架内容 -->
  <scroll-view scroll-y class="shelf-scroll" refresher-enabled refresher-triggered="{{isRefreshing}}" bindrefresherrefresh="onRefresh">

    <!-- 未登录：锁定账本，提示登录（不展示任何账本数据） -->
    <view class="empty-state" wx:if="{{locked}}">
      <view class="empty-icon">🔒</view>
      <text class="empty-text">请先登录</text>
      <text class="empty-desc">登录后即可查看与管理你的礼金账本</text>
      <button class="add-first-btn" bindtap="goToMine">
        <text class="btn-icon">👤</text>
        <text>去登录</text>
      </button>
    </view>

    <!-- 空状态：首次为空 -->
    <view class="empty-state" wx:elif="{{books.length === 0 && !isEmptyAfterDelete}}">
      <view class="empty-icon">📖</view>
      <text class="empty-text">书架空空如也</text>
      <text class="empty-desc">记录人情往来，从此不再乱</text>
      <button class="add-first-btn" bindtap="uploadExcel">
        <text class="btn-icon">+</text>
        <text>导入账本</text>
      </button>
    </view>

    <!-- 空状态：删除后为空 -->
    <view class="empty-state" wx:elif="{{books.length === 0 && isEmptyAfterDelete}}">
      <view class="empty-icon">🗑️</view>
      <text class="empty-text">所有账本已清空</text>
      <text class="empty-desc">之前的记录已全部删除</text>
      <button class="add-first-btn" bindtap="uploadExcel">
        <text class="btn-icon">+</text>
        <text>重新添加</text>
      </button>
    </view>

    <!-- 有数据 -->
    <block wx:else>
      <!-- 工具栏 -->
      <view class="toolbar">
        <view class="view-toggle" bindtap="toggleView">
          <text>{{viewMode === 'grid' ? '☰ 列表' : '▦ 网格'}}</text>
        </view>
      </view>

      <!-- 网格视图：封面主色由行内样式提供，可自定义 -->
      <view class="shelf-grid" wx:if="{{viewMode === 'grid'}}">
        <block wx:for="{{books}}" wx:key="id">
          <view class="book-item" bindtap="openBook" bindlongpress="onLongPressBook" data-id="{{item.id}}" data-title="{{item.title}}" data-index="{{index}}">
            <view class="book-card" style="background-color: {{item.displayColor}};">
              <view class="book-spine" style="background-color: {{item.displaySolid}};"></view>
              <!-- 参考图装饰：礼尚往来 / 双喜竖条 / 嘉宾礼簿 -->
              <view class="book-cover-art">
                <view class="cover-side">礼尚往来</view>
                <view class="cover-strip"><text class="cover-emblem">囍</text></view>
                <view class="cover-guest">嘉宾 · GUEST BOOK · 礼簿</view>
              </view>
              <view class="book-content">
                <view class="book-top">
                  <view class="book-color-dot" style="background-color: {{item.displaySolid}};"></view>
                  <view class="book-color-line" style="background-color: {{item.displaySolid}};"></view>
                </view>
                <view class="book-title-area">
                  <text class="book-name">{{item.title}}</text>
                </view>
                <view class="book-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
                <view class="book-bottom">
                  <view class="book-meta">
                    <text class="meta-item">¥{{item.total}}</text>
                    <text class="meta-divider">|</text>
                    <text class="meta-item">{{item.count}}人</text>
                  </view>
                  <view class="book-date">{{item.date}}</view>
                </view>
              </view>
            </view>
          </view>
        </block>
        <view class="book-item add-item" bindtap="uploadExcel">
          <view class="add-card">
            <view class="add-icon">+</view>
            <text class="add-text">新增账本</text>
          </view>
        </view>
      </view>

      <!-- 列表视图 -->
      <view class="shelf-list" wx:else>
        <block wx:for="{{books}}" wx:key="id">
          <view class="list-item" bindtap="openBook" bindlongpress="onLongPressBook" data-id="{{item.id}}" data-title="{{item.title}}" data-index="{{index}}">
            <view class="list-color-bar" style="background-color: {{item.displaySolid}};"></view>
            <view class="list-color-dot" style="background-color: {{item.displaySolid}};"></view>
            <view class="list-info">
              <view class="list-name">{{item.title}}</view>
              <view class="list-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
              <view class="list-meta">
                <text>{{item.count}}人</text>
                <text class="meta-dot">·</text>
                <text>{{item.date}}</text>
              </view>
            </view>
            <view class="list-amount">¥{{item.total}}</view>
            <view class="list-arrow">›</view>
          </view>
        </block>
        <view class="list-item add-list-item" bindtap="uploadExcel">
          <view class="list-icon add-list-icon">+</view>
          <view class="list-info">
            <view class="list-name add-list-name">新增账本</view>
          </view>
        </view>
      </view>
    </block>

    <view class="safe-bottom"></view>
  </scroll-view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" catchtouchmove="preventTouchMove">
    <view class="modal-content" catchtap="doNothing">
      <view class="modal-header">
        <text class="modal-title">编辑账本</text>
        <view class="modal-close" bindtap="closeEditModal">×</view>
      </view>
      <view class="modal-body">
        <view class="edit-item">
          <text class="edit-label">账本名称</text>
          <input class="edit-input" value="{{editTitle}}" bindinput="onEditTitle" placeholder="请输入账本名称" />
        </view>
        <view class="edit-item">
          <text class="edit-label">账本说明</text>
          <input class="edit-input" value="{{editDesc}}" bindinput="onEditDesc" placeholder="如：2025春节、同事组" />
        </view>
        <!-- 原图标选择入口改为「选择书本颜色」，操作方式不变 -->
        <view class="edit-item">
          <text class="edit-label">书本颜色</text>
          <view class="color-grid">
            <view class="color-item {{editColor === item ? 'active' : ''}}"
                  wx:for="{{colorOptions}}" wx:key="*this"
                  bindtap="selectColor" data-color="{{item}}"
                  style="background-color: {{item}};"></view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeEditModal">取消</button>
        <button class="btn-confirm" bindtap="confirmEdit">保存</button>
      </view>
    </view>
  </view>

  <!-- 导入确认弹窗 -->
  <view class="modal-mask" wx:if="{{showRenameModal}}" catchtouchmove="preventTouchMove">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">账本入库确认</text>
        <view class="modal-close" bindtap="closeRenameModal">×</view>
      </view>
      <view class="modal-body">
        <view class="edit-item">
          <text class="edit-label">账本名称</text>
          <input class="edit-input" value="{{tempName}}" bindinput="onInputName" focus placeholder="请输入账本名称" />
        </view>
        <view class="info-row">
          <view class="info-item">
            <text class="info-value">{{tempData.length}}</text>
            <text class="info-label">条记录</text>
          </view>
          <view class="info-item">
            <text class="info-value">¥{{tempTotal}}</text>
            <text class="info-label">礼金总额</text>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeRenameModal">取消</button>
        <button class="btn-confirm" bindtap="confirmImport">确认保存</button>
      </view>
    </view>
  </view>
</view>
