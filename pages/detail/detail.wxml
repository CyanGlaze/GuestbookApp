<view class="container">
  <!-- 顶部固定区域 -->
  <view class="sticky-header">
    <!-- 自定义导航栏（毛玻璃贯穿） -->
    <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-inner" style="height: {{navBarHeight}}px;">
        <view class="nav-back" catchtap="goBack">‹</view>
        <text class="nav-title">账本详情</text>
        <view class="nav-right"></view>
      </view>
    </view>
    <!-- 账本信息栏 -->
    <view class="book-info-bar">
      <view class="book-title">
        <text class="book-icon">{{bookIcon}}</text>
        <text class="title-text">{{bookTitle}}</text>
      </view>
      <view class="book-stats">
        <text class="stat-item">共{{totalCount}}人</text>
        <text class="stat-divider">|</text>
        <text class="stat-item">¥{{totalAmount}}</text>
      </view>
    </view>
    <!-- 搜索框 -->
    <view class="search-box {{searchFocused ? 'focused' : ''}}">
      <view class="search-icon">🔍</view>
      <input class="search-input" placeholder="搜索姓名/拼音/地址" bindinput="onSearch" bindfocus="onSearchFocus" bindblur="onSearchBlur" value="{{searchKey}}" />
      <view class="search-right">
        <view class="count-tag" wx:if="{{searchCount > 0}}">{{searchCount}}条</view>
        <view class="clear-btn" wx:if="{{searchKey}}" bindtap="clearSearch">✕</view>
      </view>
    </view>
  </view>

  <!-- 列表区域 -->
  <scroll-view class="list-scroll" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation>
    <view wx:for="{{displayData}}" wx:for-item="group" wx:key="letter" id="letter-{{group.letter === '#' ? 'special' : group.letter}}">
      <view class="group-title">{{group.letter}}</view>

      <view class="gift-card card-level-{{item.amountLevel || 0}}" wx:for="{{group.items}}" wx:key="_key" bindlongpress="onLongPressCard" data-item="{{item}}">
        <view class="card-content">
          <!-- 第一行：姓名左（带头像）+ 金额右（带档位徽标） -->
          <view class="card-row">
            <view class="name-wrap">
              <view class="name-avatar avatar-c{{item.avatarColor}}">{{item.firstLetter}}</view>
              <view class="name">
                <text wx:for="{{item.nameSeg}}" wx:for-item="seg" wx:key="id" class="{{seg.hit ? 'highlight' : ''}}">{{seg.text}}</text>
              </view>
            </view>
            <view class="amount-wrap">
              <text class="amount">¥{{item['礼金']}}</text>
              <text class="level-tag tag-l{{item.amountLevel}}" wx:if="{{item.levelTag}}">{{item.levelTag}}</text>
            </view>
          </view>
          <!-- 第二行：地址左 + 备注右 -->
          <view class="card-row" wx:if="{{item['地址'] || item['备注']}}">
            <view class="addr" wx:if="{{item['地址']}}">
              <text class="addr-icon">📍</text>
              <text wx:for="{{item.addrSeg}}" wx:for-item="seg" wx:key="id">{{seg.text}}</text>
            </view>
            <view class="addr-placeholder" wx:else></view>
            <view class="remark" wx:if="{{item['备注']}}">
              <text class="remark-icon">📝</text>
              <text>{{item['备注']}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态：账本无记录 -->
    <view class="empty-result" wx:if="{{displayData.length === 0 && !searchKey}}">
      <text class="empty-icon">📖</text>
      <text class="empty-text">还没有任何记录</text>
      <text class="empty-hint">点右下角 + 添加第一条礼金记录</text>
    </view>

    <!-- 空状态：搜索无结果 -->
    <view class="empty-result" wx:if="{{displayData.length === 0 && searchKey}}">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">未找到相关记录</text>
      <text class="empty-hint">试试其他关键词</text>
    </view>
    <view class="safe-bottom"></view>
  </scroll-view>

  <!-- 右侧字母索引 -->
  <view class="sidebar" catchtouchstart="onSidebarTouchStart" catchtouchmove="onSidebarTouchMove" catchtouchend="onSidebarTouchEnd">
    <view wx:for="{{alphabet}}" wx:key="*this" class="side-item {{currentLetter == item ? 'active' : ''}}">{{item}}</view>
  </view>

  <!-- 字母提示气泡 -->
  <view class="letter-bubble" wx:if="{{showLetterTip}}">{{currentLetter}}</view>

  <!-- 添加按钮 -->
  <view class="add-float-btn" bindtap="onAddRecord">
    <text>+</text>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" catchtouchmove="preventTouchMove" bindtap="closeEditModal">
    <view class="modal-content" catchtap="preventTouchMove">
      <view class="modal-header">
        <text class="modal-title">{{isAdding ? '新增记录' : '编辑记录'}}</text>
        <view class="modal-close" bindtap="closeEditModal">×</view>
      </view>
      <view class="modal-body">
        <view class="input-row">
          <text class="input-label">姓名</text>
          <input class="input-field" value="{{editingItem['姓名']}}" data-key="姓名" bindinput="onEditInput" placeholder="请输入姓名" />
        </view>
        <view class="input-row">
          <text class="input-label">礼金</text>
          <input class="input-field" type="digit" value="{{editingItem['礼金']}}" data-key="礼金" bindinput="onEditInput" placeholder="请输入金额" />
        </view>
        <view class="input-row">
          <text class="input-label">地址</text>
          <input class="input-field" value="{{editingItem['地址']}}" data-key="地址" bindinput="onEditInput" placeholder="请输入地址" />
        </view>
        <view class="input-row">
          <text class="input-label">备注</text>
          <input class="input-field" value="{{editingItem['备注']}}" data-key="备注" bindinput="onEditInput" placeholder="请输入备注" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeEditModal">取消</button>
        <button class="btn-save" bindtap="saveFullEdit">保存</button>
      </view>
    </view>
  </view>
</view>
