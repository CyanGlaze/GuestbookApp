/* ===== iOS 风格毛玻璃设计系统 ===== */
page {
  /* 系统色板 */
  --ios-bg: #f2f2f7;
  --ios-label: #1c1c1e;
  --ios-secondary: #8e8e93;
  --ios-tertiary: #aeaeb2;
  --ios-blue: #007aff;
  --brand: #667eea;
  --brand-deep: #764ba2;
  --money: #c0392b;
  --danger: #ff3b30;

  /* 玻璃材质 */
  --glass: rgba(255, 255, 255, 0.66);
  --glass-strong: rgba(255, 255, 255, 0.86);
  --glass-soft: rgba(255, 255, 255, 0.42);
  --glass-border: rgba(255, 255, 255, 0.8);
  --glass-divider: rgba(60, 60, 67, 0.1);
  --glass-shadow: 0 8rpx 32rpx rgba(31, 38, 63, 0.1);
  --glass-shadow-lg: 0 16rpx 48rpx rgba(31, 38, 63, 0.14);
  --glass-blur: blur(24px) saturate(180%);
  --glass-blur-sm: blur(14px) saturate(160%);
  --r-lg: 32rpx;
  --r-md: 24rpx;
  --r-sm: 16rpx;

  /* 环境光：毛玻璃背后要有可虚化的色彩 */
  background-color: var(--ios-bg);
  background-image:
    radial-gradient(circle at 8% 2%, rgba(102, 126, 234, 0.30) 0, rgba(102, 126, 234, 0) 46%),
    radial-gradient(circle at 94% 20%, rgba(118, 75, 162, 0.24) 0, rgba(118, 75, 162, 0) 44%),
    radial-gradient(circle at 18% 76%, rgba(88, 166, 255, 0.20) 0, rgba(88, 166, 255, 0) 42%),
    radial-gradient(circle at 90% 94%, rgba(255, 149, 120, 0.16) 0, rgba(255, 149, 120, 0) 40%);
  background-repeat: no-repeat;
  min-height: 100vh;
  color: var(--ios-label);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, input, button, scroll-view { box-sizing: border-box; }
button::after { border: none; }

.container { min-height: 100vh; padding: 0; box-sizing: border-box; background: transparent; }

/* 通用玻璃面板（可直接在页面复用） */
.glass {
  background: var(--glass);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-md);
  box-shadow: var(--glass-shadow), inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
}
.glass-strong {
  background: var(--glass-strong);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-lg);
  box-shadow: var(--glass-shadow-lg), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.btn-primary {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.94) 0%, rgba(118, 75, 162, 0.94) 100%);
  -webkit-backdrop-filter: var(--glass-blur-sm);
  backdrop-filter: var(--glass-blur-sm);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx rgba(102, 126, 234, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}
.btn-primary:active { transform: scale(0.98); box-shadow: 0 4rpx 14rpx rgba(102, 126, 234, 0.2); }
.card-shadow { box-shadow: var(--glass-shadow); }
.gradient-bg { background: linear-gradient(135deg, rgba(102, 126, 234, 0.9), rgba(118, 75, 162, 0.9)); }
.safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* 弹窗遮罩：iOS sheet 背后的变暗 + 模糊 */
.modal-mask {
  background: rgba(20, 22, 32, 0.34);
  -webkit-backdrop-filter: blur(12px) saturate(150%);
  backdrop-filter: blur(12px) saturate(150%);
}

/* ===== iOS 26 液态玻璃（Liquid Glass）设计层 =====
   配方统一：低透填充 + 强模糊高饱和 + 渐变高光描边 + 双层投影。
   各页面引用这些变量保持观感一致；detail 页因触摸兼容使用伪玻璃（无 blur）。 */
page {
  --lg-fill: rgba(255, 255, 255, 0.44);
  --lg-fill-strong: rgba(255, 255, 255, 0.62);
  --lg-fill-faux: rgba(255, 255, 255, 0.74);
  --lg-edge: rgba(255, 255, 255, 0.60);
  --lg-blur: blur(34px) saturate(210%);
  --lg-blur-deep: blur(46px) saturate(220%);
  --lg-shadow: 0 14rpx 48rpx rgba(31, 38, 63, 0.13), 0 2rpx 10rpx rgba(31, 38, 63, 0.06);
  /* 玻璃边缘四面内侧高光，模拟液态折射 */
  --lg-spec:
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.92),
    inset 1rpx 0 1rpx rgba(255, 255, 255, 0.42),
    inset -1rpx 0 1rpx rgba(255, 255, 255, 0.42),
    inset 0 -1rpx 1rpx rgba(255, 255, 255, 0.24);
  --lg-ease: cubic-bezier(0.34, 1.56, 0.64, 1);
}

.lg {
  background: var(--lg-fill);
  -webkit-backdrop-filter: var(--lg-blur);
  backdrop-filter: var(--lg-blur);
  border: 1.5rpx solid var(--lg-edge);
  border-radius: var(--r-lg);
  box-shadow: var(--lg-spec), var(--lg-shadow);
  transition: transform 0.28s var(--lg-ease), box-shadow 0.28s ease;
}
.lg-press:active { transform: scale(0.97); }

/* 环境光再加强一档，让液态玻璃有更明显的透色与折射感 */
.lg-ambient {
  background-image:
    radial-gradient(circle at 10% 0%, rgba(102, 126, 234, 0.38) 0, rgba(102, 126, 234, 0) 50%),
    radial-gradient(circle at 96% 16%, rgba(118, 75, 162, 0.30) 0, rgba(118, 75, 162, 0) 46%),
    radial-gradient(circle at 14% 72%, rgba(88, 166, 255, 0.26) 0, rgba(88, 166, 255, 0) 44%),
    radial-gradient(circle at 92% 92%, rgba(255, 149, 120, 0.22) 0, rgba(255, 149, 120, 0) 42%),
    radial-gradient(circle at 50% 118%, rgba(52, 199, 89, 0.14) 0, rgba(52, 199, 89, 0) 38%);
}

/* ============================================================
   iOS 27 · Real Glass 统一动效层（全局复用）
   仅补充变量与工具类，不影响既有 --lg-* 配方。
   ============================================================ */
page {
  --rg-blur: blur(40px) saturate(220%);
  --rg-blur-deep: blur(54px) saturate(230%);
  --rg-ease: cubic-bezier(0.34, 1.56, 0.64, 1);
  --rg-dur: 0.45s;
}

/* 入场：自下而上浮现 */
@keyframes rgFadeUp {
  0% { opacity: 0; transform: translateY(30rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
/* 弹入：轻微放大上浮 */
@keyframes rgPopIn {
  0% { opacity: 0; transform: translateY(44rpx) scale(0.94); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
/* 环境光浮球：缓慢上下浮动 */
@keyframes rgFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
/* 玻璃高光扫过 */
@keyframes rgShimmer {
  0% { background-position: -160% 0; }
  100% { background-position: 160% 0; }
}

.rg-fade-up { animation: rgFadeUp var(--rg-dur) var(--rg-ease) both; }
.rg-pop-in { animation: rgPopIn var(--rg-dur) var(--rg-ease) both; }
.rg-press { transition: transform 0.22s var(--rg-ease), box-shadow 0.22s ease; }
.rg-press:active { transform: scale(0.97); }

/* 环境光浮球：不拦截触摸，置于内容之下 */
.ambient-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(60px);
  animation: rgFloat 9s ease-in-out infinite;
  z-index: 0;
}
