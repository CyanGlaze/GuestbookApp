/* ===== 我的 · iOS 液态玻璃（伪玻璃版） =====
   注：本机真机上 backdrop-filter 层会拦截点击（详情页曾复现），
   故交互页面统一改用「高透填充 + 高光描边 + 投影」模拟液态玻璃，
   不使用真实模糊；观感与全局配方一致，点击响应恢复正常。 */
.container {
  min-height: 100vh;
  position: relative;
  background-color: #f2f2f7;
  background-image:
    radial-gradient(circle at 8% 6%, rgba(102, 126, 234, 0.30) 0, rgba(102, 126, 234, 0) 48%),
    radial-gradient(circle at 94% 26%, rgba(118, 75, 162, 0.26) 0, rgba(118, 75, 162, 0) 46%),
    radial-gradient(circle at 14% 78%, rgba(88, 166, 255, 0.22) 0, rgba(88, 166, 255, 0) 44%),
    radial-gradient(circle at 88% 92%, rgba(255, 160, 200, 0.18) 0, rgba(255, 160, 200, 0) 42%);
  background-repeat: no-repeat;
}

/* 顶部彩色层：加高 + 缓慢渐隐 */
.top-bg {
  position: absolute; top: 0; left: 0; right: 0;
  height: 1040rpx;
  z-index: 1;
  overflow: hidden;
  background: linear-gradient(180deg,
    rgba(102, 126, 234, 0.92) 0%,
    rgba(118, 75, 162, 0.78) 42%,
    rgba(118, 75, 162, 0.30) 76%,
    rgba(118, 75, 162, 0) 100%);
}
.circle {
  position: absolute; border-radius: 50%;
  filter: blur(40px);
}
.circle-1 {
  width: 380rpx; height: 380rpx; top: 100rpx; right: -80rpx;
  background: rgba(255, 255, 255, 0.22);
}
.circle-2 {
  width: 260rpx; height: 260rpx; top: 380rpx; left: -90rpx;
  background: rgba(255, 180, 220, 0.36);
}
.circle-3 {
  width: 320rpx; height: 320rpx; top: 560rpx; right: -60rpx;
  background: rgba(120, 180, 255, 0.38);
}

.nav-bar { position: relative; z-index: 2; background: transparent; }
.nav-inner { display: flex; align-items: center; justify-content: center; }
.nav-title {
  font-size: 34rpx; font-weight: 600; color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.18);
}

/* 固定 240rpx：不依赖 statusBarHeight，任何机型都明显下移并避开胶囊 */
.content {
  position: relative; z-index: 10;
  padding: 240rpx 32rpx 40rpx;
}

/* ===== 通用按压反馈（配合 WXML hover-class）===== */
.item-pressed { transform: scale(0.97); opacity: 0.85; }
.btn-pressed { transform: scale(0.96); opacity: 0.85; }

/* ===== 用户卡片 ===== */
.user-card {
  display: flex; align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1.5rpx solid var(--lg-edge);
  box-shadow: var(--lg-spec), var(--lg-shadow);
}
.avatar-wrapper {
  margin-right: 28rpx; padding: 6rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}
.avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95); display: block;
}
.avatar-placeholder {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(242, 242, 247, 0.9);
  display: flex; align-items: center; justify-content: center; font-size: 56rpx;
}
.user-info { flex: 1; min-width: 0; }
.nickname { font-size: 38rpx; font-weight: 700; color: #17171a; display: block; }
.auth-tag {
  display: inline-flex; align-items: center; gap: 8rpx;
  margin-top: 14rpx; padding: 8rpx 18rpx; border-radius: 20rpx;
  background: rgba(52, 199, 89, 0.16);
  border: 1rpx solid rgba(52, 199, 89, 0.24);
}
.auth-icon { font-size: 22rpx; color: #1f8f3d; }
.auth-tag text { font-size: 24rpx; color: #1f8f3d; }
.login-btn {
  margin-top: 18rpx; padding: 14rpx 32rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.94), rgba(118, 75, 162, 0.94));
  color: #fff; font-size: 28rpx; border-radius: 32rpx; border: none;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}
.login-btn::after { border: none; }

/* ===== 分区标题 ===== */
.section-head { margin: 64rpx 8rpx 24rpx; }
.section-title { font-size: 26rpx; color: #565b68; letter-spacing: 1rpx; }

/* ===== 快捷操作 ===== */
.quick-actions { display: flex; gap: 20rpx; }
.quick-action-item {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; align-items: center;
  padding: 36rpx 12rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1.5rpx solid var(--lg-edge);
  box-shadow: var(--lg-spec), 0 10rpx 32rpx rgba(31, 38, 63, 0.12);
  transition: transform 0.2s;
}
.quick-action-icon {
  width: 88rpx; height: 88rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; margin-bottom: 18rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.92), rgba(118, 75, 162, 0.92));
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}
.quick-action-text { font-size: 28rpx; font-weight: 650; color: #17171a; }
.quick-action-desc { font-size: 22rpx; color: #767b86; margin-top: 8rpx; }

/* ===== 数据总览大卡 ===== */
.overview-card {
  border-radius: 36rpx; padding: 40rpx 32rpx 34rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1.5rpx solid var(--lg-edge);
  box-shadow: var(--lg-spec), 0 14rpx 40rpx rgba(31, 38, 63, 0.13);
}
.overview-main { display: flex; flex-direction: column; align-items: center; padding-bottom: 30rpx; }
.overview-label { font-size: 24rpx; color: #767b86; }
.overview-value {
  font-size: 64rpx; font-weight: 800; color: #4d61c9;
  line-height: 1.2; margin-top: 10rpx;
  font-variant-numeric: tabular-nums; letter-spacing: -1rpx;
}
.overview-divider { height: 1rpx; background: rgba(60, 60, 67, 0.12); margin: 0 8rpx; }
.overview-sub { display: flex; padding-top: 28rpx; }
.overview-sub-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sub-value { font-size: 34rpx; font-weight: 700; color: #17171a; }
.sub-label { font-size: 22rpx; color: #767b86; margin-top: 6rpx; }

/* ===== 更多操作 ===== */
.menu-list {
  border-radius: 30rpx; overflow: hidden;
  background: rgba(255, 255, 255, 0.74);
  border: 1.5rpx solid var(--lg-edge);
  box-shadow: var(--lg-spec), 0 10rpx 30rpx rgba(31, 38, 63, 0.10);
}
.menu-item { display: flex; align-items: center; padding: 32rpx; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 30rpx; color: #17171a; }
.menu-text.danger { color: #e0332b; }
.menu-arrow { font-size: 32rpx; color: #b9bdc5; }

/* ===== 退出登录（水平 + 垂直双向居中） ===== */
.logout-section {
  margin-top: 64rpx;
  min-height: 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.logout-btn {
  width: 62%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  text-align: center;
  height: 92rpx; line-height: 1;
  border-radius: 46rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.72);
  color: #e0332b; font-size: 30rpx; font-weight: 600;
  box-shadow: var(--lg-spec), 0 10rpx 32rpx rgba(224, 51, 43, 0.10);
}
.logout-btn::after { border: none; }

/* ===== 底部说明 ===== */
.footer-note {
  display: flex; flex-direction: column; align-items: center;
  margin-top: 96rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.footer-line { font-size: 22rpx; color: #969ba5; line-height: 1.8; }
.footer-version { font-size: 22rpx; color: #b7bbc3; margin-top: 18rpx; letter-spacing: 2rpx; }

/* ===== 未登录 ===== */
.login-tip-box { display: flex; flex-direction: column; align-items: center; padding: 140rpx 0; }
.tip-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.tip-text { font-size: 28rpx; color: #8e8e93; }

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20, 22, 32, 0.42);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000; animation: modalFadeIn 0.15s ease;
}
.modal-content {
  width: 620rpx; border-radius: 36rpx; overflow: hidden;
  background: rgba(255, 255, 255, 0.92);
  border: 1.5rpx solid var(--lg-edge);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  animation: modalPopIn 0.2s ease;
}
@keyframes modalFadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes modalPopIn {
  from { opacity: 0; transform: translateY(60rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.modal-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx; border-bottom: 1rpx solid rgba(60, 60, 67, 0.10);
}
.modal-title { font-size: 32rpx; font-weight: 600; color: #17171a; }
.modal-close { font-size: 48rpx; color: #aeaeb2; line-height: 1; }
.modal-body { padding: 32rpx; }
.input-group { margin-bottom: 32rpx; }
.label { font-size: 28rpx; color: #767b86; margin-bottom: 16rpx; display: block; }
.name-input {
  width: 100%; height: 88rpx; border-radius: 16rpx;
  padding: 0 24rpx; font-size: 30rpx; box-sizing: border-box;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(255, 255, 255, 0.9); color: #17171a;
}
.info-row {
  display: flex; justify-content: space-around;
  padding: 24rpx 0; border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.62);
}
.info-item { text-align: center; }
.info-value { font-size: 36rpx; font-weight: 700; color: #4d61c9; display: block; }
.info-label { font-size: 24rpx; color: #767b86; margin-top: 8rpx; display: block; }
.modal-footer {
  display: flex; padding: 24rpx 32rpx; gap: 24rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.10);
}
.btn-cancel, .btn-confirm {
  flex: 1; height: 80rpx; border-radius: 40rpx; font-size: 30rpx;
  display: flex; align-items: center; justify-content: center; border: none;
}
.btn-cancel {
  background: rgba(255, 255, 255, 0.75); color: #5b606b;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}
.btn-confirm {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.94), rgba(118, 75, 162, 0.94));
  color: #fff; border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}
.btn-cancel::after, .btn-confirm::after { border: none; }
.btn-confirm.full { flex: none; width: 100%; }

/* ===== 表情头像（备选头像 / 默认头像） ===== */
.avatar-emoji {
  display: flex; align-items: center; justify-content: center;
  font-size: 0; /* 由内部 text 控制大小 */
}
.avatar-emoji-text {
  font-size: 64rpx; line-height: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.18));
}

/* ===== iOS 27 玻璃观感 =====
   重要：真实 backdrop-filter 在真机上会吞掉其内部可点元素的触摸事件（本项目已多次实锤）。
   故真实模糊只用于「纯装饰、内部不含可点目标」的表面（数据总览卡 / 导航栏）；
   含按钮或可点项的容器（用户卡 / 快捷操作 / 菜单项 / 退出按钮 / 弹窗）改用伪玻璃填充，
   观感一致且真机点击正常。 */
.overview-card,
.nav-bar {
  background: var(--lg-fill);
  -webkit-backdrop-filter: var(--lg-blur);
  backdrop-filter: var(--lg-blur);
}

/* ===== 未登录 · 登录界面（按参考图布局）===== */
.login-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx 20rpx;
}
/* Logo 卡片：iOS 玻璃白卡 + 红绿蓝彩色簿册 */
.login-logo-card {
  width: 156rpx;
  height: 156rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx solid rgba(255, 255, 255, 0.80);
  box-shadow:
    0 16rpx 40rpx rgba(102, 126, 234, 0.22),
    inset 0 1.5rpx 0 rgba(255, 255, 255, 0.95);
}
.book-stack { display: flex; align-items: flex-end; gap: 10rpx; }
.book-spine { width: 26rpx; border-radius: 8rpx; }
.book-red { height: 78rpx; background: linear-gradient(180deg, #ff8a8a, #e8443f); }
.book-green { height: 96rpx; background: linear-gradient(180deg, #7be0a0, #27b46a); }
.book-blue { height: 84rpx; background: linear-gradient(180deg, #7aa8ff, #3a5ad8); }

.login-title {
  font-size: 46rpx; font-weight: 800; color: #17171a;
  margin-top: 30rpx; letter-spacing: 2rpx;
}
.login-subtitle { font-size: 26rpx; color: #767b86; margin-top: 14rpx; }

/* 白色半透明登录卡 · iOS 液态玻璃 */
.login-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 44rpx;
  padding: 52rpx 40rpx 46rpx;
  border-radius: 48rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.52));
  border: 1.5rpx solid rgba(255, 255, 255, 0.65);
  /* 外层投影悬浮感 + 内层顶部高光 + 底部暗描边，模拟玻璃厚度 */
  box-shadow:
    0 22rpx 56rpx rgba(31, 38, 63, 0.20),
    inset 0 1.5rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.login-card-title { font-size: 34rpx; font-weight: 700; color: #17171a; }
.login-card-desc { font-size: 24rpx; color: #767b86; margin-top: 12rpx; }

/* 微信一键登录按钮 · 白色玻璃胶囊 + 微信绿 */
.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  margin-top: 28rpx;
  padding: 26rpx 0;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1.5rpx solid rgba(255, 255, 255, 0.85);
  box-shadow:
    0 12rpx 28rpx rgba(7, 193, 96, 0.20),
    inset 0 1.5rpx 0 rgba(255, 255, 255, 0.95);
}
.wechat-icon-img {
  width: 46rpx; height: 46rpx;
}
.wechat-login-text { color: #07C160; font-size: 33rpx; font-weight: 700; letter-spacing: 1rpx; }
.wechat-login-btn::after { border: none; }

/* 分隔线 + 功能亮点 */
.login-divider {
  display: flex; align-items: center; gap: 16rpx;
  width: 100%; margin: 40rpx 0 28rpx;
}
.divider-line { flex: 1; height: 1rpx; background: rgba(60, 60, 67, 0.12); }
.divider-text { font-size: 22rpx; color: #9a9aa2; }
.feature-row { display: flex; justify-content: space-around; width: 100%; }
.feature-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.feature-icon {
  width: 84rpx; height: 84rpx; border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 6rpx 14rpx rgba(31, 38, 63, 0.10);
}
.feature-label { font-size: 22rpx; color: #6b6f7a; }

/* 底部协议 */
.agreement {
  margin-top: 52rpx;
  text-align: center;
  font-size: 22rpx; color: #969ba5; line-height: 1.8;
}
.agree-link { color: #5b6fd8; }
