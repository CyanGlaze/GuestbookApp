<view class="container">
  <!-- 彩色环境光 + 自定义导航栏 -->
  <view class="top-bg">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
    <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-inner" style="height: {{navBarHeight}}px;">
        <text class="nav-title">我的</text>
      </view>
    </view>
  </view>

  <view class="content">
    <!-- 已登录：用户卡片；未登录：登录界面（二者平级切换） -->
    <block wx:if="{{isLogin}}">
      <view class="user-card">
        <view class="avatar-wrapper">
          <image wx:if="{{userInfo.avatarType === 'image'}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar avatar-emoji" style="background: {{userInfo.avatarBg}}">
            <text class="avatar-emoji-text">{{userInfo.avatarEmoji}}</text>
          </view>
        </view>
        <view class="user-info">
          <text class="nickname">{{userInfo.nickName}}</text>
          <view class="auth-tag">
            <text class="auth-icon">✓</text>
            <text>已授权登录</text>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="login-screen">
        <!-- Logo 卡片：红绿蓝彩色簿册 -->
        <view class="login-logo-card">
          <view class="book-stack">
            <view class="book-spine book-red"></view>
            <view class="book-spine book-green"></view>
            <view class="book-spine book-blue"></view>
          </view>
        </view>
        <text class="login-title">礼金账本</text>
        <text class="login-subtitle">记录每一份情谊</text>

        <!-- 登录卡片 -->
        <view class="login-card">
          <text class="login-card-title">微信登录</text>
          <text class="login-card-desc">获取微信头像与昵称，安全便捷</text>

          <button class="wechat-login-btn" open-type="chooseAvatar"
                  bindchooseavatar="onChooseAvatar" binderror="onAvatarError"
                  hover-class="btn-pressed" hover-stay-time="80">
            <image class="wechat-icon-img" src="/images/wechat.png" mode="aspectFit"></image>
            <text class="wechat-login-text">微信一键登录</text>
          </button>

          <view class="login-divider">
            <view class="divider-line"></view>
            <text class="divider-text">功能亮点</text>
            <view class="divider-line"></view>
          </view>

          <view class="feature-row">
            <view class="feature-item">
              <view class="feature-icon">📊</view>
              <text class="feature-label">导入Excel</text>
            </view>
            <view class="feature-item">
              <view class="feature-icon">🔍</view>
              <text class="feature-label">智能搜索</text>
            </view>
            <view class="feature-item">
              <view class="feature-icon">✏️</view>
              <text class="feature-label">便捷编辑</text>
            </view>
          </view>
        </view>

        <!-- 协议 -->
        <view class="agreement">
          <text>登录即表示同意</text>
          <text class="agree-link" bindtap="showAgreement" data-type="user">《用户协议》</text>
          <text>和</text>
          <text class="agree-link" bindtap="showAgreement" data-type="privacy">《隐私政策》</text>
        </view>
      </view>
    </block>

    <!-- 未登录时不显示以下功能，登录后展示 -->
    <block wx:if="{{isLogin}}">
      <!-- 账本管理 -->
      <view class="section-head"><text class="section-title">账本管理</text></view>
      <view class="quick-actions">
        <view class="quick-action-item" hover-class="item-pressed" hover-stay-time="80" bindtap="uploadExcel">
          <view class="quick-action-icon">📊</view>
          <text class="quick-action-text">导入账本</text>
          <text class="quick-action-desc">xlsx / xls</text>
        </view>
        <view class="quick-action-item" hover-class="item-pressed" hover-stay-time="80" bindtap="exportBackup">
          <view class="quick-action-icon">📤</view>
          <text class="quick-action-text">导出备份</text>
          <text class="quick-action-desc">保存数据</text>
        </view>
        <view class="quick-action-item" hover-class="item-pressed" hover-stay-time="80" bindtap="importBackup">
          <view class="quick-action-icon">📥</view>
          <text class="quick-action-text">导入备份</text>
          <text class="quick-action-desc">恢复数据</text>
        </view>
      </view>

      <!-- 数据总览 -->
      <view class="section-head"><text class="section-title">数据总览</text></view>
      <view class="overview-card">
        <view class="overview-main">
          <text class="overview-label">累计礼金</text>
          <text class="overview-value">¥{{totalAmount}}</text>
        </view>
        <view class="overview-divider"></view>
        <view class="overview-sub">
          <view class="overview-sub-item">
            <text class="sub-value">{{totalBooks}}</text>
            <text class="sub-label">本账谱</text>
          </view>
          <view class="overview-sub-item">
            <text class="sub-value">{{totalRecords}}</text>
            <text class="sub-label">条记录</text>
          </view>
        </view>
      </view>

      <!-- 更多操作 -->
      <view class="section-head"><text class="section-title">更多操作</text></view>
      <view class="menu-list">
        <view class="menu-item" hover-class="item-pressed" hover-stay-time="80" bindtap="clearAllData">
          <view class="menu-icon">🗑️</view>
          <text class="menu-text danger">清空所有数据</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="logout-section" wx:if="{{isLogin}}">
        <button class="logout-btn" hover-class="btn-pressed" hover-stay-time="80" bindtap="onLogout">退出登录</button>
      </view>

      <view class="footer-note">
        <text class="footer-line">数据仅保存在本机，清理微信缓存或卸载会丢失</text>
        <text class="footer-line">建议定期使用「导出备份」保存账本</text>
        <text class="footer-version">礼金账本 · 玻璃版 v2</text>
      </view>
    </block>
  </view>

  <!-- 导入确认弹窗 -->
  <view class="modal-mask" wx:if="{{showRenameModal}}" catchtouchmove="preventTouchMove">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">账本入库确认</text>
        <view class="modal-close" hover-class="btn-pressed" bindtap="closeModal">×</view>
      </view>
      <view class="modal-body">
        <view class="input-group">
          <text class="label">账本名称</text>
          <input class="name-input" value="{{tempName}}" bindinput="onInputName" focus placeholder="请输入账本名称" />
        </view>
        <view class="info-row">
          <view class="info-item">
            <text class="info-value">{{tempData.length}}</text>
            <text class="info-label">条记录</text>
          </view>
          <view class="info-item">
            <text class="info-value">¥{{tempTotal}}</text>
            <text class="info-label">礼金总额</text>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" hover-class="btn-pressed" bindtap="closeModal">取消</button>
        <button class="btn-confirm" hover-class="btn-pressed" bindtap="confirmSave">确认保存</button>
      </view>
    </view>
  </view>
</view>
